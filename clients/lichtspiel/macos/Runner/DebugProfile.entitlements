<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Talking to the Lichtspiel server. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Finding servers on the home network: the answers to the search arrive on a UDP socket the app opens. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Uploading a poster: reading the picture chosen in the file dialog. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Downloads are saved to the Downloads folder. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
